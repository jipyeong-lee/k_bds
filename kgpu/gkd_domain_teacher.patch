+    def _set_teacher_domain(self, inputs):
+        """Activate the teacher expert adapter of this micro-batch's domain (image path contains /<domain>/)."""
+        if not self._teacher_domains:
+            return
+        hits = set()
+        for inp in inputs:
+            paths = ' '.join(str(p.get('path') if isinstance(p, dict) else p) for p in inp.get('images') or [])
+            found = [d for d in self._teacher_domains if f'/{d}/' in paths]
+            if len(found) != 1:
+                raise ValueError(f'teacher domain not resolvable: images={paths[:200]!r} domains={self._teacher_domains}')
+            hits.add(found[0])
+        if len(hits) != 1:
+            raise ValueError(f'micro-batch mixes domains {sorted(hits)}; use per_device_train_batch_size 1')
+        domain = hits.pop()
+        self.accelerator.unwrap_model(self.teacher_model).set_adapter(domain, inference_mode=True)
+        self._teacher_domain_steps[domain] += 1
+
